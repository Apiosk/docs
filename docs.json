{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Apiosk",
  "description": "Ask a question, review the price, and get sourced data through the App, API, or MCP server.",
  "colors": {
    "primary": "#8a4ef7",
    "light": "#b39bff",
    "dark": "#6d28d9"
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png",
    "href": "https://apiosk.com"
  },
  "favicon": "/images/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Back to Site",
        "href": "https://apiosk.com"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": false,
      "url": "full"
    },
    "examples": {
      "languages": [
        "bash",
        "typescript"
      ],
      "defaults": "required",
      "prefill": false,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "overview/quickstart",
              "overview/payment-model",
              "overview/terminology",
              "overview/faq",
              "overview/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Buy data",
            "pages": [
              "api/authentication",
              "api/sources",
              "api/execute",
              "api/ask",
              "api/workflows",
              "api/continue",
              "api/runs"
            ]
          },
          {
            "group": "Use cases",
            "pages": [
              "api/sales-signals"
            ]
          },
          {
            "group": "Operating it",
            "pages": [
              "api/billing",
              "api/idempotency",
              "api/errors",
              "api/limits"
            ]
          }
        ],
        "openapi": "openapi/apiosk-api.json"
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Assistants",
            "pages": [
              "mcp/overview",
              "guides/mcp-clients"
            ]
          }
        ]
      },
      {
        "tab": "App",
        "groups": [
          {
            "group": "Your organisation",
            "pages": [
              "app/organisations",
              "app/api-keys",
              "app/connections"
            ]
          }
        ]
      }
    ]
  },

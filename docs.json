    "links": [
      {
        "label": "Back to Site",
        "href": "https://apiosk.com"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": false,
      "url": "full"
    },
    "examples": {
      "languages": [
        "bash",
        "typescript"
      ],
      "defaults": "required",
      "prefill": false,
      "autogenerate": true
    }
  },

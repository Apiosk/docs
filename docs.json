{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Apiosk",
  "description": "Buy verifiable data per call: the API, the MCP server, the app, and publishing on the x402 rail.",
  "colors": {
    "primary": "#6349db",
    "light": "#c3a0ff",
    "dark": "#4931ad"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/favicon.svg",
